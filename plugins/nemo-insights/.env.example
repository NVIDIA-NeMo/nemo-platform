#
# Analyst credentials — self-contained (no fallback to INFERENCE_* / OPENAI_* /
# Experimentalist / Eval Author). Copy next to optimizer.yaml as `.env`.
#
# Required:
# ANALYST_API_KEY=
#
# Optional (defaults shown):
# ANALYST_API_BASE=https://inference-api.nvidia.com
# ANALYST_MODEL_NAME=aws/anthropic/bedrock-claude-opus-4-8
#
# Platform URL (optional; defaults to the active nemo auth context / localhost:8080):
# NMP_BASE_URL=http://localhost:8080
