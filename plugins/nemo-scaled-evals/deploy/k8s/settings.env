# Settings shared by the API and both workers.
#
# ${SE_*} placeholders name a specific cloud project, so their values live in an
# untracked local.env (see local.env.example). apply.sh substitutes them and
# refuses to apply while any is unresolved.
#
# scaled-evals runs on its own Postgres and never reads the platform's DATABASE_*
# config. The DSN needs the password, which is a Secret, so it is assembled per
# container (see api.yaml / workers.yaml) rather than set here.

# Artifacts live in GCS, reached with Workload Identity tokens from the metadata
# server rather than HMAC keys. uploadMode=auto prefers V4 signed URLs when
# IAM Credentials signBlob is available.
OBJECT_STORE_BACKEND=gcs
GCS_BUCKET=${SE_GCS_BUCKET}
GCS_UPLOAD_MODE=auto
GCS_SIGNING_SERVICE_ACCOUNT=${SE_GCP_SERVICE_ACCOUNT}
GCS_SIGNED_URL_REGION=auto

# Task images are built by Cloud Build from the uploaded pack, not by an
# in-cluster BuildKit. This is the difference that matters versus the compose
# stack, where BUILDKIT_ENABLED is true and Cloud Build is off.
BUILDKIT_ENABLED=false
CLOUD_BUILD_ENABLED=true
CLOUD_BUILD_PROJECT=${SE_GCP_PROJECT}
CLOUD_BUILD_LOCATION=us-central1
CLOUD_BUILD_DOCKER_BUILDER_IMAGE=gcr.io/cloud-builders/docker
CLOUD_BUILD_SERVICE_ACCOUNT=${SE_CLOUD_BUILD_SERVICE_ACCOUNT}
CLOUD_BUILD_TIMEOUT_SECONDS=2100
CLOUD_BUILD_POLL_INTERVAL_SECONDS=5

# A dedicated registry path for task images, so nothing built here can collide
# with another deployment's task repositories.
REGISTRY_ENABLED=false
IMAGE_REGISTRY=${SE_TASK_IMAGE_REGISTRY}
REGISTRY_INSECURE=false
TASK_IMAGE_VALIDATION_MODE=resolve
TASK_IMAGE_ALLOWED_REGISTRIES=us-central1-docker.pkg.dev
TASK_IMAGE_ALLOWED_REPOSITORIES=${SE_TASK_IMAGE_REGISTRY}/*
TASK_IMAGE_REGISTRY_INSECURE=false
# GAR requires auth even to read a manifest, so resolving the digest of a
# freshly built image needs the credentials the refresh CronJob mints.
TASK_IMAGE_REGISTRY_AUTH_FILE=/var/run/scaled-evals/registry-auth/.dockerconfigjson

BUILD_WORKER_REQUIRED=true
DISPATCH_HEALTH_MODE=configured

# Evaluation runtime. Harbor and the patched sandbox-k8s adapter are baked into
# the image; the cluster supplies the agent-sandbox CRDs and controller.
SANDBOX_K8S_ENABLED=true
HARBOR_DIR=/opt/harbor/default
# Oracle config: runs the task's reference solution, so it needs no model
# credentials. Swap this path for an agent config once a model route exists.
SANDBOX_K8S_CONFIG_PATH=/harness/tasks/hello-world/configs/harbor_oracle_k8s.yaml
SANDBOX_K8S_ENV_FILE=/run/target/sandbox.env
# Both must be writable by the pod's uid, and both are emptyDir mounts.
SANDBOX_K8S_WORK_DIR=/tmp/sandbox-k8s
SANDBOX_K8S_JOBS_DIR=jobs/sandbox-k8s
SANDBOX_K8S_ARTIFACT_ROOT=/var/lib/scaled-evals/harbor-jobs/sandbox-k8s
SANDBOX_K8S_ALLOW_INSECURE_TLS=false
# GAR digests resolve fine with the CronJob credentials, but tag mode keeps the
# sandbox pod spec readable in `kubectl describe`.
SANDBOX_K8S_TASK_IMAGE_REFERENCE_MODE=tag
