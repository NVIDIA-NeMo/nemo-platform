    {
      "id": "draft-0",
      "intent": "Draft a short staff warning about a phishing email.",
      "inputs": {
        "instruction": "{\"user_message\": \"write a warning for the team about this\", \"emails\": [\"Subject: Claim Your Free iPhone Now!\\nFrom: prize@example.com\\n\\nCongratulations! Click http://malicious-link.example.com/claim to claim your prize.\"]}"
      },
      "reference": {
        "expected_elements": "names the lure, says not to click, says how to report"
      },
      "metrics": [
        {
          "bundle_kind": "metric-bundle",
          "bundle_format_version": "v1",
          "metric_type": "llm-judge",
          "metadata": {
            "description": "Warning draft quality, graded on a rubric.",
            "labels": {}
          },
          "outputs": [
            {
              "name": "draft_quality",
              "description": null,
              "value_json_schema": {
                "description": "Continuous numeric metric value.",
                "title": "ContinuousScore",
                "type": "number"
              }
            },
            {
              "name": "draft_quality.label",
              "description": "Selected rubric label for draft_quality",
              "value_json_schema": {
                "description": "String label metric value.",
                "title": "Label",
                "type": "string"
              }
            }
          ],
          "secrets": {},
          "payload": {
            "kind": "inline",
            "metric": {
              "type": "llm-judge",
              "model": "default/nvidia-nemotron-3-super-120b-a12b",
              "prompt_template": {
                "messages": [
                  {
                    "role": "user",
                    "content": "You are grading a short warning message a security analyst drafted for employees about a phishing email.\n\nA complete warning contains these elements: {{ item.reference.expected_elements }}.\n\nAgent response:\n{{ sample.output_text }}\n\nGrade by how many of those elements are present:\n- poor: none of them, or no actionable guidance at all.\n- adequate: some but not all.\n- strong: all of them, stated briefly.\n\nRespond with a JSON object {\"draft_quality\": \"<label>\"} where label is exactly one of poor, adequate, or strong."
                  }
                ]
              },
              "scores": [
                {
                  "name": "draft_quality",
                  "rubric": [
                    {
                      "label": "poor",
                      "description": "None of the expected elements, or no actionable guidance.",
                      "value": 0.0
                    },
                    {
                      "label": "adequate",
                      "description": "Some of the expected elements, but not all.",
                      "value": 0.5
                    },
                    {
                      "label": "strong",
                      "description": "All of the expected elements, stated briefly.",
                      "value": 1.0
