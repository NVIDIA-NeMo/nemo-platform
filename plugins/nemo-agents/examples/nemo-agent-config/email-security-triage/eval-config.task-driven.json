            "kind": "inline",
            "metric": {
              "type": "llm-judge",
              "model": "default/nvidia-nemotron-3-super-120b-a12b",
              "prompt_template": {
                "messages": [
                  {
                    "role": "user",
                    "content": "You are scoring an email security analyst's default review. The analyst was given {{ item.reference.message_count }} selected messages and no question, so the review should contain one block per message, headed [1], [2], and so on, each reporting VERDICT, ATTACK_TYPE, IOCS, ACTION and REASONING.\n\nThe correct VERDICT for each message, in order, is: {{ item.reference.verdicts }}\n\nAgent response:\n{{ sample.output_text }}\n\nRespond with a JSON object with exactly these two keys:\n  \"verdict_accuracy\": the fraction (0 to 1) of messages whose VERDICT line matches the correct verdict for that position, or 0 if per-message verdicts are absent.\n  \"report_completeness\": the fraction (0 to 1) of expected field slots across all messages that are present AND populated with a sensible value."
                  }
                ]
              },
              "scores": [
                {
                  "name": "verdict_accuracy",
                  "minimum": 0.0,
                  "maximum": 1.0
                },
                {
                  "name": "report_completeness",
                  "minimum": 0.0,
                  "maximum": 1.0
                }
              ],
              "inference": {
                "max_tokens": 1024,
                "extra_body": {
                  "nvext": {
                    "max_thinking_tokens": 256
                  }
                }
              },
              "reasoning": {
                "end_token": "</think>"
              }
            }
          }
        }
      ],
      "views": {
        "default_review": {
          "reducer": "mean",
          "signals": [
            {
              "metric": "string-check",
              "output": "string-check"
            },
            {
              "metric": "llm-judge",
              "output": "verdict_accuracy"
            },
            {
              "metric": "llm-judge",
              "output": "report_completeness"
            }
          ]
        }
