{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@nemo/common": ["../../../web/packages/common/src/plugin.ts"],
      "@nemo/common/*": ["../../../web/packages/common/*"],
      "@nemo/sdk/*": ["../../../web/packages/sdk/*"],
      // Common's ControlledTextInput/Select/TextArea take a react-hook-form
      // `control`, so the type must have ONE identity. Two copies (this pnpm
      // root's and Studio's) make tsc compare Control's recursive private
      // internals structurally and fail, even at the same version.
      "react-hook-form": ["../../../web/packages/common/node_modules/react-hook-form"],
      "@iron-swarm/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
