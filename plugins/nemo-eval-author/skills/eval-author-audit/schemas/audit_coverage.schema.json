{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developer.nvidia.com/nemo/eval-author/audit_coverage.schema.json",
  "title": "NeMo Eval Author audit coverage report",
  "description": "Shared per-trace coverage result consumed by audit coverage aggregation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "audit",
    "subject",
    "method",
    "item_kind",
    "covered"
  ],
  "properties": {
    "schema": {
      "description": "Version marker for the shared audit coverage format.",
      "const": "nemo.eval_author.audit_coverage.v1"
    },
    "audit": {
      "description": "Audit spec metadata for the denominator used by this measurement.",
      "$ref": "#/$defs/audit"
    },
    "subject": {
      "description": "The task or trial trace measured by this report.",
      "$ref": "#/$defs/subject"
    },
    "method": {
      "description": "Measurement method that produced this coverage file.",
      "$ref": "#/$defs/method"
    },
    "item_kind": {
      "description": "Audit item kind this coverage file covers.",
      "enum": [
        "capability",
        "failure_case",
        "tool"
      ]
    },
    "covered": {
      "description": "Stable audit item names this trace covered according to the selected method.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/itemName"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "description": "String value that must contain at least one non-whitespace character.",
      "type": "string",
      "pattern": "\\S"
    },
    "itemName": {
      "description": "Stable machine-readable audit item or tool name.",
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:/-]*$"
    },
    "pathString": {
      "description": "Local file or directory path recorded as a string.",
      "$ref": "#/$defs/nonEmptyString"
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "schema",
        "agent",
        "status",
        "item_count"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/pathString"
        },
        "schema": {
          "const": "nemo.eval_author.audit.v1"
        },
        "agent": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "enum": [
            "draft",
            "approved"
          ]
        },
        "item_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace",
        "trace_format",
        "task_id"
      ],
      "properties": {
        "trace": {
          "$ref": "#/$defs/pathString"
        },
        "trace_format": {
          "const": "atif"
        },
        "task_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "trial_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "harbor_trial_dir": {
          "$ref": "#/$defs/pathString"
        },
        "harbor_result": {
          "$ref": "#/$defs/pathString"
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/itemName"
        }
      }
    }
  }
}
