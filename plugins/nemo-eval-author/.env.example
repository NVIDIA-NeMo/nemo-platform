#
# Run `nemo setup` to register a provider and select default and fast models.
# The stored active context is used by default. These environment variables are
# only needed to override it in a non-interactive or isolated environment.
# NMP_BASE_URL=http://localhost:8080
# NEMO_DEFAULT_MODEL=default/gpt-4-1
# NEMO_FAST_MODEL=default/gpt-4-1-mini
