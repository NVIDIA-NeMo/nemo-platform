# Platform
# NMP_BASE_URL=http://localhost:8080

# Shared OpenAI-compatible credentials (Experimentalist / Tau3)
export INFERENCE_API_BASE=https://inference-api.nvidia.com/v1
export INFERENCE_API_KEY=sk-...
export OPENAI_API_KEY="$INFERENCE_API_KEY"
export OPENAI_BASE_URL="$INFERENCE_API_BASE"

# Experimentalist (required for `nemo agents experimentalist run`)
export NEMO_EXPERIMENTALIST_API_KEY="$INFERENCE_API_KEY"
export NEMO_EXPERIMENTALIST_API_BASE="$INFERENCE_API_BASE"
# Model tiers — set smart at minimum; mid/fast inherit smart when unset.
export NEMO_EXPERIMENTALIST_MODELS_SMART=openai/openai/openai/gpt-5.6-sol
# export NEMO_EXPERIMENTALIST_MODELS_MID=openai/openai/openai/gpt-5.6-terra
# export NEMO_EXPERIMENTALIST_MODELS_FAST=openai/openai/openai/gpt-5.6-luna
# Optional: NEMO_DEFAULT_MODEL=vendor/model fills SMART only when it contains `/`.

# Analyst (self-contained; required for `nemo agents analyst run`)
# export ANALYST_API_BASE=https://inference-api.nvidia.com
# export ANALYST_API_KEY=sk-...
# export ANALYST_MODEL_NAME=aws/anthropic/bedrock-claude-opus-4-8

# Upstream Tau3 currently reads these compatibility variable names.
export TAU2_USER_MODEL=openai/openai/openai/gpt-5.6-luna
export TAU2_NL_ASSERTIONS_MODEL=openai/openai/openai/gpt-5.6-luna
export AUT_MODEL_NAME=openai/openai/openai/gpt-5.6-luna
