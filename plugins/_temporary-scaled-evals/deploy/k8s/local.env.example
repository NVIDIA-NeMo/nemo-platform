#
# Every value that names *your* cloud project lives here and nowhere else, so the
# committed manifests stay deployment-agnostic. `apply.sh` substitutes these into
# the rendered output; it refuses to apply while any placeholder is unresolved.
#
#   cp local.env.example local.env    # then fill in, it is gitignored
#   ./apply.sh
#
# See README.md for the GCP resources these refer to, which apply.sh does not
# create.

# GCS bucket holding task packs and evaluation artifacts.
SE_GCS_BUCKET=

# GCP project that runs Cloud Build for task images.
SE_GCP_PROJECT=

# Service account the control-plane pods impersonate through Workload Identity.
# Needs object access on the bucket above plus IAM Credentials signBlob for V4
# signed URLs. Full email form.
SE_GCP_SERVICE_ACCOUNT=

# Service account Cloud Build runs builds as, in the long
# `projects/<project>/serviceAccounts/<email>` form the Cloud Build API expects.
SE_CLOUD_BUILD_SERVICE_ACCOUNT=

# Artifact Registry repository that built *task* images are pushed to.
SE_TASK_IMAGE_REGISTRY=

# Artifact Registry repository holding the scaled-evals *application* image, and
# the tag to roll out. Keep the tag immutable so a rollout always names the code
# it runs.
SE_APP_IMAGE=
SE_APP_IMAGE_TAG=

# Python package index carrying the harbor and sandbox-k8s wheels, passed to the
# image build as HARBOR_EXTRA_INDEX_URL. Needed because sandbox-k8s is not on
# PyPI, so a build without this cannot resolve it. Used only when building the
# image, but apply.sh requires every key here to have a value, so set it even
# when deploying an image somebody else built.
SE_HARBOR_INDEX_URL=
