{
  "model": "default/nemotron-3-5-lightning-30b-a3b-bf16",
  "dataset": "default/math-with-judge-data",
  "environment": "default/math-with-judge-env",
  "training": {
    "type": "grpo",
    "finetuning_type": "lora",
    "lora": {
      "rank": 128,
      "alpha": 512,
      "dropout": 0.0,
      "exclude_modules": ["*out_proj*"],
      "use_triton": false
    },
    "automodel_kwargs": { "force_hf": true },
    "router_aux_loss_coef": 0.0,
    "vllm_tensor_parallel_size": 4,
    "vllm_gpu_memory_utilization": 0.7,
    "max_steps": 300,
    "batch_size": 128,
    "micro_batch_size": 1,
    "num_prompts_per_step": 16,
    "num_generations_per_prompt": 8,
    "learning_rate": 1e-5,
    "max_seq_length": 4096,
    "max_new_tokens": 2048,
    "activation_checkpointing": true,
    "parallelism": { "num_nodes": 1, "num_gpus_per_node": 8 }
  },
  "output": { "name": "nemotron-30ba3b-grpo-lora" }
}
