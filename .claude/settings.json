{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "nmp"
  ],
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install *)",
      "Bash(pnpm add *)",
      "Bash(pnpm list *)",
      "Bash(pnpm dev)",
      "Bash(pnpm dev *)",
      "Bash(pnpm create *)",
      "Bash(./node_modules/.bin/tsc *)",
      "Bash(./node_modules/.bin/vite *)",
      "Bash(git init)",
      "Bash(git init *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(curl -sI *)",
      "mcp__Claude_Preview__preview_screenshot",
      "mcp__Claude_Preview__preview_console_logs",
      "mcp__Claude_Preview__preview_start",
      "mcp__Claude_Preview__preview_inspect",
      "mcp__Claude_Preview__preview_network",
      "mcp__Claude_Preview__preview_fill",
      "mcp__Claude_Preview__preview_click"
    ]
  },
  "sandbox": {
    "excludedCommands": [
      "docker *",
      "docker-compose *",
      "make bootstrap",
      "make bootstrap-studio"
    ],
    "filesystem": {
      "allowWrite": [
        "$HOME/.config/nmp",
        "$HOME/.local/share/nemo"
      ]
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/web/.claude/hooks/post-edit.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/web/.claude/hooks/nvm-on-cd.sh"
          }
        ]
      }
    ]
  }
}
