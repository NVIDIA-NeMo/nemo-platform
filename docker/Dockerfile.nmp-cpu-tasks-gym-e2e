# syntax=docker/dockerfile:1
# CI-only nmp-cpu-tasks variant for real NeMo Gym evaluator E2E jobs.
#
# This image is intentionally excluded from release targets. Production Gym packaging remains a
# separate decision because Gym requires Ray, which the platform workspace excludes for an unfixed
# critical CVE. Test model configuration is supplied per job through GymRunnerTarget.env_overrides.

ARG NMP_CPU_TASKS_BASE=nmp-cpu-tasks
FROM ${NMP_CPU_TASKS_BASE}

COPY docker/locks/nmp-cpu-tasks-gym-e2e /opt/nmp-cpu-tasks-gym-e2e-lock

RUN uv venv --python /usr/local/bin/python3.13 /opt/gym-venv \
    && UV_PROJECT_ENVIRONMENT=/opt/gym-venv uv sync \
        --project /opt/nmp-cpu-tasks-gym-e2e-lock \
        --locked \
        --no-dev \
        --no-install-project \
    && ln -s /opt/gym-venv/bin/gym /usr/local/bin/gym

LABEL com.nvidia.nemo-platform.ci-only="true"
