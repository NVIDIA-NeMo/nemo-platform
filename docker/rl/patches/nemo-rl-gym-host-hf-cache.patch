+def _install_huggingface_cache_fallback() -> None:
+    """Copy a vendored HF cache off the read-only dataset mount into writable work.
+
+    Hub loaders that ignore ``vf_env_args.dataset_path`` still call
+    ``load_dataset("org/name")``. Point ``HF_HOME`` at a writable copy so that
+    hits cache with ``HF_HUB_OFFLINE=1``. Do not set ``HF_HOME`` at the dataset
+    mount: ``datasets`` writes lock files there and fails on a read-only
+    filesystem. No-op when the FileSet has no ``.huggingface/`` snapshot.
+    """
+    dataset_path = os.environ.get(DATASET_PATH_ENV_KEY, "").strip()
+    work_path = os.environ.get(WORK_PATH_ENV_KEY, "").strip()
+    if not dataset_path or not work_path:
+        return
+    src = os.path.join(dataset_path, HF_CACHE_DIRNAME)
+    if not os.path.isdir(src):
+        return
+    dest = os.path.join(work_path, HF_CACHE_DIRNAME)
+    if os.path.exists(dest):
+        shutil.rmtree(dest)
+    shutil.copytree(src, dest)
+    os.environ["HF_HOME"] = dest
+    os.environ["HF_HUB_OFFLINE"] = "1"
+    os.environ["HF_DATASETS_OFFLINE"] = "1"
+
+
 def bootstrap_gym_host() -> tuple[Any, Any, Any]:
     """Start Gym servers and return (RunHelper, head_server_config, RolloutCollectionHelper)."""
+    # Before RunHelper.start() so Gym child processes inherit HF_HOME / offline flags.
+    _install_huggingface_cache_fallback()
