# Gym-enabled task image for NeMo Evaluator agent-evaluation jobs.
#
# Gym and Ray are isolated from the shared CPU task image. Test and model configuration is supplied
# per job through GymRunnerTarget.hydra_params.

ARG NMP_CPU_TASKS_BASE=nmp-cpu-tasks
ARG NMP_PYTHON_BASE=nmp-python-base

FROM ${NMP_CPU_TASKS_BASE} AS cpu-tasks

FROM ${NMP_PYTHON_BASE} AS gym-builder
COPY --from=cpu-tasks /app/.venv /app/.venv
ENV VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:$PATH"

COPY docker/locks/nmp-gym-tasks /opt/nmp-gym-tasks-lock

RUN uv venv --python /usr/local/bin/python3.13 /opt/gym-venv \
    && UV_PROJECT_ENVIRONMENT=/opt/gym-venv uv sync \
        --project /opt/nmp-gym-tasks-lock \
        --locked \
        --no-dev \
        --no-install-project

FROM cpu-tasks AS runtime
COPY --chown=1000:1000 --from=gym-builder /opt/gym-venv /opt/gym-venv
ENV PATH="/opt/gym-venv/bin:/app/.venv/bin:$PATH" \
    PYTHONPATH=""

FROM runtime AS smoke-test
RUN gym --help >/dev/null \
    && /opt/gym-venv/bin/python -c \
        'import importlib.metadata as m; import nemo_gym, ray, tiktoken; print({"nemo-gym": m.version("nemo-gym"), "ray": m.version("ray"), "tiktoken": m.version("tiktoken")})'

FROM runtime
