#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

# Flox's pnpm_10 launcher embeds a Nix-store Node 24 interpreter, while this
# repository pins Node 22. Run pnpm's JavaScript entry point with the active
# Node binary so pnpm and Node satisfy the same repository constraints.
if [ "${TOOLCHAIN:-flox}" = "system" ]; then
    if ! command -v node >/dev/null 2>&1 || ! command -v pnpm >/dev/null 2>&1; then
        echo "Node.js and pnpm must be on PATH when TOOLCHAIN=system." >&2
        exit 1
    fi
    exec node "$(command -v pnpm)" "$@"
fi

if [ "${FLOX_ENV_PROJECT:-}" = "$repo_root" ]; then
    exec node "$(command -v pnpm)" "$@"
fi

if ! command -v flox >/dev/null 2>&1; then
    echo "pnpm is unavailable. Install Flox or provide Node.js and pnpm on PATH." >&2
    exit 1
fi

exec flox activate --dir "$repo_root" -- bash -c 'exec node "$(command -v pnpm)" "$@"' pnpm "$@"
